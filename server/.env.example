# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Groq Cloud API (Required for AI Recipe Generation & Grocery Vision Scanner)
# 1. Sign up for free at: https://console.groq.com/keys
# 2. Click "Create API Key"
# 3. Paste the key below (starts with gsk_)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Resend API (For Live Expiry Reminder Emails)
# Get a free API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_EMAIL=PantryPal AI <onboarding@resend.dev>

# Supabase Server Settings
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional but recommended for automated server cron (bypasses RLS to check all users' expiring items):
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Automated Expiry Reminder Cron Job
CRON_SCHEDULE=0 9 * * *
CRON_ENABLED=true
CRON_SECRET=your_secure_cron_webhook_secret
